# Configuración de Base de Datos PostgreSQL
# Para local: postgresql://postgres:password@localhost:5432/medpred
# Para Render: copiar la DATABASE_URL de Render
DATABASE_URL=postgresql://postgres:password@localhost:5432/medpred

# Configuración de Django
DEBUG=False
SECRET_KEY=your-super-secret-key-here
ALLOWED_HOSTS=yourdomain.onrender.com,localhost,127.0.0.1

# Configuración de Email (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion

# Configuración de Supabase
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-key-here

# JWT
JWT_SECRET=your-jwt-secret-here
